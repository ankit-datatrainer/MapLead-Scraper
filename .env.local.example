# Supabase — get these from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for server-side admin operations (API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override the public site URL (used for OG images, sitemaps)
# For local development, use http://localhost:3000
# For Vercel, set this to your production domain (e.g., https://yourdomain.com)
# Vercel will auto-populate this with VERCEL_PROJECT_PRODUCTION_URL if not set
NEXT_PUBLIC_SITE_URL=http://localhost:3000
